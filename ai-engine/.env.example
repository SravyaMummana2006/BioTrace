# ==============================================================================
# BIOTRACE AI ENGINE CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Settings
BIOTRACE_HOST=127.0.0.1
BIOTRACE_PORT=8000
BIOTRACE_WORKERS=1
BIOTRACE_DEBUG=false

# Media and Pipeline Constraints
BIOTRACE_MAX_VIDEO_SIZE_MB=500
BIOTRACE_ALLOWED_EXTENSIONS=.mp4,.avi,.mov,.mkv
BIOTRACE_MAX_ANALYSIS_SECONDS=60.0
BIOTRACE_DEFAULT_SAMPLING_FPS=30.0

# Hardware Acceleration
BIOTRACE_DEVICE=auto
BIOTRACE_WORKER_THREADS=4

# Storage Paths
BIOTRACE_UPLOAD_DIR=data/uploads
BIOTRACE_CACHE_DIR=data/cache

# Logging
BIOTRACE_LOG_LEVEL=INFO
